<div class="message">
    <p><strong>Author:</strong> <%= message.username %> </p>
    <p><strong>Message:</strong> <%= message.message_text %> </p>
    <p><strong>Date added:</strong> <%= message.time %> </p>
    <div class="message-open-button">
        <a href="/messages/<%= message.id %>">Open</a>
    </div>
</div>